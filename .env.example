# Copy to .env and fill in real values. Never commit .env.

# --- Service identity ---
# Must match the AMI's /model-cache/{SERVICE_NAME}/ folder and is reported
# as-is in the webhook payload's "service_name" field.
SERVICE_NAME=video_ai_service

# --- SQS ---
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/video-ai-service-queue
# Purely a heartbeat-log interval; no effect on control flow.
IDLE_TIMEOUT_SECONDS=60

# --- Postgres (raw psycopg2, no ORM) ---
DB_HOST=localhost
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=changeme
DB_PORT=5432

# --- Webhook back to the core service ---
WEBHOOK_URL=https://core-service.placeholder/webhook

# --- AWS (source video download from S3 / thumbnail upload) ---
# Leave blank to fall back to the default credential chain (e.g. EC2 instance role).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_BUCKET_NAME=5dot-storage

# --- Optional overrides (sensible defaults if unset) ---
# Local folder shared with the lip_sync/scene_detection containers via bind mount.
SHARED_JOBS_DIR=/tmp/shared_jobs
# Deepfake probability threshold used to derive Fake/Real (kept for reference; the
# worker currently stores the raw probability, not a thresholded verdict).
THRESHOLD=0.5
# Max seconds to wait for another service's ".done" download marker before failing the job.
DOWNLOAD_WAIT_TIMEOUT_SECONDS=600
